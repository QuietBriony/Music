// Generated by build.mjs. Only this app's static files and seven opted-in
// sounds are cached. Drafts/FILE saves remain owned by localStorage.
const RELEASE = __RELEASE_JSON__;
const ASSETS = __ASSETS_JSON__;
const SHELL_PREFIX = 'music-workbench-shell-';
const SHELL_CACHE = SHELL_PREFIX + RELEASE;
const shellFiles = new Map(ASSETS.map((file) => [file.url, file]));
let saving = false;

async function saveShell() {
  const cache = await caches.open(SHELL_CACHE);
  const missing = [];
  for (const file of ASSETS) if (!await cache.match(file.url)) missing.push(file);
  let next = 0;
  await Promise.all(Array.from({ length: Math.min(4, missing.length) }, async () => {
    while (next < missing.length) {
      const file = missing[next++];
      const response = await fetch(file.url, { cache: 'reload' });
      if (!response.ok || await soundDigest(await response.clone().arrayBuffer()) !== file.sha256) {
        throw new Error('アプリの更新内容が揃っていません。ネット接続中に更新してください。');
      }
      await cache.put(file.url, response);
    }
  }));
}

self.addEventListener('install', (event) => event.waitUntil(saveShell()));
self.addEventListener('activate', (event) => event.waitUntil((async () => {
  for (const name of await caches.keys()) {
    if (name.startsWith(SHELL_PREFIX) && name !== SHELL_CACHE) await caches.delete(name);
  }
  await self.clients.claim();
})()));

async function packState() {
  const sounds = await readSoundPack(caches, self.location.origin);
  const cache = await caches.open(SHELL_CACHE);
  const keys = new Set((await cache.keys()).map((request) => new URL(request.url).pathname));
  const shellReady = ASSETS.every((file) => keys.has(file.url));
  return { release: RELEASE, shellReady, soundsReady: sounds.ready, preparedAt: sounds.preparedAt,
    soundBytes: sounds.bytes || 0, appBytes: ASSETS.reduce((sum, file) => sum + file.bytes, 0) };
}

self.addEventListener('message', (event) => {
  if (event.data?.source !== 'music-workbench-pwa-v1' || !event.ports[0]
      || !event.source?.url || new URL(event.source.url).origin !== self.location.origin) return;
  const port = event.ports[0];
  event.waitUntil((async () => {
    try {
      if (event.data.action === 'status') port.postMessage({ result: await packState() });
      else if (event.data.action === 'activate') {
        await self.skipWaiting();
        port.postMessage({ result: true });
      } else if (event.data.action === 'save-sounds') {
        if (saving) throw new Error('ほかの画面で保存中です。少し待ってください。');
        saving = true;
        try {
          await saveShell();
          await saveSoundPack({ storage: caches, origin: self.location.origin,
            progress: (progress) => port.postMessage({ progress }) });
          port.postMessage({ result: await packState() });
        } finally { saving = false; }
      }
    } catch (error) { port.postMessage({ error: error.message || '保存設定を確認してください' }); }
  })());
});

async function registryResponse(request) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 4_000);
  try {
    const response = await fetch(request, { signal: controller.signal });
    if (response.ok) return response;
    throw new Error('registry unavailable');
  } catch {
    return new Response(JSON.stringify(offlineRegistry(request.url)),
      { headers: { 'Content-Type': 'application/json' } });
  } finally { clearTimeout(timeout); }
}

async function cachedSound(request, file) {
  const state = await readSoundPack(caches, self.location.origin);
  if (state.cacheName) {
    const response = await (await caches.open(state.cacheName)).match(new URL(file.key, self.location.origin).href);
    if (response) return soundRange(response, request.headers.get('Range'));
  }
  try { return await fetch(request); }
  catch { return new Response('この音は未保存です。ネット接続中にオフライン用の音を保存してください。', { status: 503 }); }
}

self.addEventListener('fetch', (event) => {
  const request = event.request;
  if (request.method !== 'GET') return;
  if (SAMPLE_REGISTRIES.includes(request.url)) {
    event.respondWith(registryResponse(request));
    return;
  }
  const sound = soundFileFor(request.url, self.location.origin);
  if (sound) { event.respondWith(cachedSound(request, sound)); return; }
  const url = new URL(request.url);
  if (url.origin !== self.location.origin || url.pathname.startsWith('/api/')) return;
  const path = url.pathname.endsWith('/') ? url.pathname + 'index.html' : url.pathname;
  if (!shellFiles.has(path)) return;
  event.respondWith((async () => {
    const response = await (await caches.open(SHELL_CACHE)).match(path);
    if (response) return soundRange(response, request.headers.get('Range'));
    // Repair a missing file only if it still matches this active release.
    try { await saveShell(); return await (await caches.open(SHELL_CACHE)).match(path); }
    catch { return new Response('アプリを保存できていません。ネット接続中に更新してください。', { status: 503 }); }
  })());
});
