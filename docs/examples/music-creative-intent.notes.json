  "music_intent": {
    "timbre": [
      "低音の芯、弦の立ち上がりと胴、ドラムの打感を大切にする",
      "音色キット・Pad・リズム・空間を連続して変える",
      "静かなモードでは音数と刺激を増やしすぎない"
    ],
    "rhythm": [
      "反復とポケットを土台に、声や楽器の入る間を残す",
      "固定するパートと変奏するパートを分ける",
      "BPM・密度・強弱・変化量を同じ一つの値として扱わない"
    ],
    "space": [
      "声と楽器が同じ空間にいる距離を作る",
      "Dubは呼びかけ、返事、反響、休符、戻り方までを編曲する",
      "手を離したあとの尾と音の小さな返事を残す"
    ],
    "structure": [
      "作品の目的に応じて床・歌もの・ロック・IDM・静かなAmbientを選ぶ",
      "昔の自作曲は原音を参照し、調和・Dub・再構成を区別して育てる",
      "生活の具体物から視点や時間の尺度を動かし、具体物へ帰る方法を試す"
    ],
    "gesture": [
      "触ると結果が聴こえ、休む・戻す・残す操作が分かる",
      "一つのパートを固定し、一要素だけ変えて同じ区間を比較する",
      "気に入った版を既存work IDと親revisionへ紐づける"
    ],
    "safety": [
      "metadata-only",
      "実際の再生・録音・外部機器の開始は既存の手動境界を守る",
      "計測の合格と本人の聴感を区別し、採用verdictを生成しない",
      "歌詞本文・音声・私的なチャット原文をこのJSONに含めない"
    ]
  },
