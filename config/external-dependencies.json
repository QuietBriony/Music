    "machine_registry": "config/music-machines.json",
    "catalog": "presets/online-samples-catalog.json",
    "mutable_branch_urls": "forbidden",
    "unknown_license_behavior": "keep pending and do not promote as cleared",
    "model_weight_storage": "repo_external",
    "model_download": "deny_unless_explicit",
    "license_statuses": [
      "verified",
      "pending",
      "not_applicable"
    ],
    "revision_statuses": [
      "verified",
      "snapshot_only",
      "provider_managed"
    ],
    "integrity_statuses": [
      "verified",
      "pending",
      "not_applicable"
    ],
    "size_statuses": [
      "measured_local",
      "upstream_reported",
      "github_repo_reported",
      "upper_bound",
      "provider_limit"
    ],
    "model_weight_extensions": [
      ".ckpt",
      ".gguf",
      ".onnx",
      ".pt",
      ".pth",
      ".safetensors"
    ],
    "user_dynamic_urls": {
      "classification": "user_dynamic",
      "consumers": [
        "band-room.js custom kit localStorage"
      ],
      "manifest_pin_required": false,
      "tracked_catalog_promotion_requires_manifest": true,
      "note": "A URL typed by the user is not a tracked dependency. It must never be copied into the catalog without an immutable source revision, license evidence, and size budget."
